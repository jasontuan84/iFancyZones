<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    Hardened runtime with one exception.

    disable-library-validation is REQUIRED while the app is ad-hoc signed:
    an ad-hoc signature has no Team ID, and library validation then refuses
    the bundled Qt frameworks ("mapping process and mapped file (non-platform)
    have different Team IDs"), so dyld aborts at launch. It can go once the
    app is signed with a Developer ID, which gives the app and its frameworks
    the same Team ID.

    No JIT, no unsigned executable memory and no Apple Events are needed.
    Accessibility and Login Items are TCC / SMAppService grants, not
    entitlements.
-->
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
